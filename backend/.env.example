# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://nyaya:nyaya@localhost:5433/nyaya

# LLM: any OpenAI-compatible API.
# Default: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# Note: on the free tier Google may use prompts to improve its products. Don't send real users'
# data through it; use the paid tier or a local model for that.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
MODEL_MAIN=gemini-3.8-flash          # search analysis + chat
MODEL_FAST=gemini-3.5-flash-lite     # intake, document extraction, brief (much faster)
MODEL_BULK=gemini-3.5-flash-lite     # judgment summaries at ingestion

# Speed: keep model "thinking" short, and fail fast instead of waiting minutes on free-tier rate limits.
# Set LLM_REASONING_EFFORT= (empty) for providers that don't support it.
LLM_REASONING_EFFORT=low
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=90

# Alternative: fully local and free with Ollama (https://ollama.com), no data leaves your machine.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# MODEL_MAIN=qwen3:14b
# MODEL_BULK=qwen3:8b

# OCR for scanned PDFs and photos (docs/ocr_steps.md). Install: brew install tesseract tesseract-lang
# Optional second engine: uv sync --extra paddle. Compare with: uv run python -m eval.run_ocr_eval
OCR_ENABLED=true
OCR_ENGINE=tesseract            # tesseract (default, see docs/ocr_report.md) | paddle | auto
OCR_LANGUAGES=eng+hin+mar       # Tesseract
OCR_PADDLE_LANG=en              # PaddleOCR: en, or hi / mr for Devanagari documents
OCR_DPI=300
OCR_MAX_PAGES=30
OCR_MIN_CONFIDENCE=60
