# Copy to .env and fill in.
DATABASE_URL=postgresql+psycopg://nyaya:nyaya@localhost:5433/nyaya

# LLM: any OpenAI-compatible API.
# Default: Google Gemini free tier. Get a key at https://aistudio.google.com/apikey
# Note: on the free tier Google may use prompts to improve its products. Don't send real users'
# data through it; use the paid tier or a local model for that.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
MODEL_MAIN=gemini-3.8-flash
MODEL_BULK=gemini-3.5-flash-lite

# Alternative: fully local and free with Ollama (https://ollama.com), no data leaves your machine.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# MODEL_MAIN=qwen3:14b
# MODEL_BULK=qwen3:8b
